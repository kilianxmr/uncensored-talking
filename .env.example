# ========================================================
# Uncensored Talking (@uncensored_talking) Configuration
# ========================================================

# OpenAI / Compatible LLM API configuration for selector.py
OPENAI_API_KEY=your_openai_api_key_here
# Optional custom base URL (e.g. OpenRouter, Groq, local Ollama)
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM model to use (e.g. gpt-4o, gpt-4o-mini, claude-3-5-sonnet, llama-3.3-70b)
LLM_MODEL=gpt-4o

# B-Roll Asset APIs (Optional, enables automatic HD video/photo sourcing)
# Pexels API Key (Free at https://www.pexels.com/api/)
PEXELS_API_KEY=your_pexels_api_key_here
# Pixabay API Key (Free at https://pixabay.com/api/docs/)
PIXABAY_API_KEY=your_pixabay_api_key_here

# Whisper Model Configuration
WHISPER_MODEL=large-v3
# Hardware device: "cuda", "cpu", or "auto"
WHISPER_DEVICE=auto
# Compute type: "float16", "int8", "float32", or "auto"
WHISPER_COMPUTE_TYPE=auto

# Video Rendering Configuration
# Video encoder: "auto", "h264_nvenc", or "libx264"
VIDEO_ENCODER=auto
